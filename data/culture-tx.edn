#:culture{:url "https://en.wikipedia.org/wiki/Cold_beet_soup", :id "ltu.dish.saltibarsciai", :kind :dish, :name-local "Šaltibarščiai", :country "LTU", :retrieved-at "2026-07-17", :summary "Cold summer soup found in the cuisines of Belarus, Lithuania, Latvia, Poland and Ukraine; the Lithuanian version is widely regarded as one of the country's best-known summer dishes.", :name "Cold beet soup", :url-provenance :wikipedia-en}
#:culture{:id "ltu.dish.kugelis", :name "Kugelis", :country "LTU", :kind :dish, :summary "Traditional Lithuanian potato pudding made with potatoes, bacon, milk, onions and eggs, oven-baked and typically served with sour cream or pork rinds.", :url "https://en.wikipedia.org/wiki/Kugelis", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "ltu.beverage.midus", :name "Midus", :country "LTU", :kind :beverage, :summary "Lithuanian mead, an alcoholic beverage made of grain, honey and water that Balts have been producing for thousands of years.", :url "https://en.wikipedia.org/wiki/Midus", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "ltu.product.amber", :name "Lithuanian amber", :country "LTU", :kind :product, :summary "Fossilized resin significant to Lithuanian culture and craftsmanship; the Palanga Amber Museum, a branch of the Lithuanian National Museum of Art, houses about 4,500 amber pieces including historical artifacts, jewelry and modern works by Lithuanian craftsmen.", :url "https://en.wikipedia.org/wiki/Palanga_Amber_Museum", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
